{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ISEL to G-code Converter",
  "version": "2.6.1",
  "identifier": "com.isin.isel-to-gcode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ISEL \u2192 G-code Converter",
        "width": 900,
        "height": 620,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "publisher": "ISIN Heaters Ltd.",
    "copyright": "© ISIN Heaters Ltd. All rights reserved.",
    "icon": ["assets/icon.ico"]
  }
}
